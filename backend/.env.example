# ============================================================
# Cell & Gene Therapy Platform — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# -------------------------------------------------------
# Application
# -------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -------------------------------------------------------
# Database (PostgreSQL via asyncpg)
# -------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cgt_platform
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# -------------------------------------------------------
# Redis
# -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# -------------------------------------------------------
# Firebase
# -------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to service account JSON file (alternative to inline JSON below)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=
# Or inline the JSON (base64-encoded for env safety)
FIREBASE_SERVICE_ACCOUNT_KEY=

# -------------------------------------------------------
# Anthropic
# -------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-5
ANTHROPIC_MAX_TOKENS=4096

# -------------------------------------------------------
# External API bases
# -------------------------------------------------------
CLINICALTRIALS_API_BASE=https://clinicaltrials.gov/api/v2
OPENFDA_API_BASE=https://api.fda.gov
PUBMED_API_BASE=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
PUBMED_API_KEY=

# -------------------------------------------------------
# Google Cloud
# -------------------------------------------------------
GCS_BUCKET_NAME=cgt-platform-documents
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
CLOUD_TASKS_QUEUE=cgt-ingestion-queue
CLOUD_TASKS_LOCATION=us-central1

# -------------------------------------------------------
# Sentry (optional)
# -------------------------------------------------------
SENTRY_DSN=

# -------------------------------------------------------
# Rate limiting
# -------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=10
