# ----------------------------------------------------------
*-service-account.json
*-sa-key.json
service-account*.json
*-credentials.json
gcp-key*.json
keyfile.json
application_default_credentials.json

# ----------------------------------------------------------
# IDE / Editor
# ----------------------------------------------------------
# JetBrains
.idea/
*.iml
*.iws
*.ipr

# VS Code — keep extensions.json, not personal settings
.vscode/settings.json
.vscode/launch.json
!.vscode/extensions.json

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*
*.orig
*.suo
*.ntvs*
*.njsproj
*.sln

# ----------------------------------------------------------
# Docker
# ----------------------------------------------------------
docker-volumes/
postgres-data/
redis-data/

